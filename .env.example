PORT=3001
# Settings > Private Integrations in your GHL sub-account. Scopes: contacts.write, opportunities.readonly, opportunities.write
GHL_TOKEN=
GHL_LOCATION_ID=
GHL_PIPELINE_ID=
GHL_NEW_LEAD_STAGE_ID=
# Map stage IDs to readable names for the KPI report
GHL_STAGE_NAMES={"stage_id_1":"New Lead","stage_id_2":"Contacted"}
# Minutes until the "call this lead" task is due (high-value leads get 2)
FOLLOW_UP_MINUTES=5
# Deals with no stage change for this many days are flagged stale
STALE_DAYS=7
# Shared secret the sender must put in the x-webhook-secret header
WEBHOOK_SECRET=change-me
# 1 = log GHL calls instead of sending them
DRY_RUN=1
